# Server/build/operator template. NOT loaded automatically. Contains no credentials.
# Inject actual values into the hosting Production environment / secret manager.
# Local guarded Production commands must set NODE_ENV=production before starting npm.
# Never copy this file to mobile/. Never copy Development credentials here.
NODE_ENV=production
PATCH_ENV=production
PATCH_API_ORIGIN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
AUTH_ALLOWED_ORIGINS=
VERCEL_PROJECT_PRODUCTION_URL=
CLERK_SECRET_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
OPENAI_API_KEY=
OPENAI_CARD_MODEL=gpt-5-nano
OPENAI_CHAT_MODEL=gpt-5-nano
AI_ENABLED=true
ACCOUNT_DELETION_WORKER_SECRET=
# VERCEL_ENV is supplied by Vercel; enable system environment variables.
# Production requires production; Preview requires a separate staging configuration.
# CLERK_JWT_KEY must be absent. Backup encryption keys belong only to the operator.
# Approve real URLs/issuer/database ID in release-policy.json before building.
