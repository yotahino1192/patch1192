{
  "name": "loop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "db:import-local": "node scripts/import-cloudflare-local.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "test:onboarding-browser": "node scripts/check-onboarding.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "@libsql/isomorphic-ws": {
      "ws": "^8.21.0"
    }
  }
}
