# Explicit deployment environment; NODE_ENV is not the deployment identity.
PATCH_ENV=development
PATCH_API_ORIGIN=http://localhost:3001
# Hosted endpoints must be reviewed in config/release-policy.json.
# Backup commands only (32-byte hex key, never public/bundled):
PATCH_BACKUP_KEY=
PATCH_BACKUP_KEY_ID=v1

# Required for AI features (server-side only)
OPENAI_API_KEY=

# Required on Vercel: a hosted libSQL/Turso database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: defaults shown below
OPENAI_CARD_MODEL=gpt-5-nano
OPENAI_CHAT_MODEL=gpt-5-nano

# Clerk Web public key; use the SAME Clerk instance as mobile and the API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only: permits Clerk JWKS retrieval and key rotation.
CLERK_SECRET_KEY=
# Exact issuer from this instance (e.g. https://your-instance.clerk.accounts.dev).
CLERK_ISSUER=
# Exact Web origins, comma separated. No wildcard and no trailing slash.
AUTH_ALLOWED_ORIGINS=http://localhost:3001
# Optional PEM public key for offline JWT verification. Never a private key.
# When set, key rotation requires updating this deployment's public key.
CLERK_JWT_KEY=
