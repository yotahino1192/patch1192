# Copy to .env.development.local for a different local backend.
# Simulator localhost refers to the Mac. Physical devices need a reachable host.
PATCH_API_URL=http://localhost:3001

# For distribution, create .env.production.local instead:
# PATCH_API_URL=https://your-backend.example.com
# This URL is public and embedded in the bundle. Never put secrets here.

# Public Clerk key for the SAME instance as the API. Never use sk_* here.
PATCH_CLERK_PUBLISHABLE_KEY=
